# 销卓宝 H5 前端环境变量模板
# 复制为 .env.development / .env.production 后按场景填值
#
# 生产环境务必满足：
#   1. VITE_API_BASE_URL 指向与前端同源的反代地址（不要跨域）
#   2. 不要在浏览器里直接打 https://api.example.com/api/v1
#   3. nginx / CDN 层做 HTTPS 终止 + 鉴权转发

# 默认值；留空则 vite dev 走 vite.config.ts 的 proxy。
VITE_API_BASE_URL=

# 调试开关（开发用）
# VITE_LOG_LEVEL=debug

# 业务特性开关（与后端 FEATURE_* 配套）
# VITE_FEATURE_AI_HOME=false
