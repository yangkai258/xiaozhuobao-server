NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FEATURE_AI_HOME=false
RATE_LIMIT_AI=60/60s
# v3.0.3 ticket #1: global throttler, 100 req/min/IP by default.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql://xiaozhuobao:xiaozhuobao@localhost:5432/xiaozhuobao?schema=public
# v3.0.3 ticket #4: REDIS_URL is optional in development (in-process Map fallback); in
# production the validateProduction() check rejects deployments without a REDIS_URL — the
# Map fallback is forbidden there.
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
STORAGE_PUBLIC_BASE_URL=/api/v1/storage/files
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# v3.0.3 ticket #6: structured-logger sink. 'stdout' (default) keeps fd 1 JSON contract; 'loki'
# mirrors each line to a Loki /loki/api/v1/push endpoint.
LOG_SINK=stdout
# LOKI_URL=http://localhost:3100/loki/api/v1/push
LOKI_FLUSH_MS=2000
# v3.0.3 reviewer follow-up: LOKI_BUFFER_MAX caps the in-memory buffer so a sustained Loki
# outage cannot OOM the process. drop-oldest strategy: when full, the head is popped.
LOKI_BUFFER_MAX=1000
# v3.0.3 ticket #7: TTL for the /health/ready probe cache so kubelet / Prometheus don't
# hammer Prisma on every scrape.
HEALTH_CACHE_TTL_MS=1000
OTEL_SERVICE_NAME=xzb-server
OTEL_PROM_PORT=9464
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_EXPORTER=none
